# Copy to .env and fill in. Never commit .env.
# Used by docker compose, and by `mvn quarkus:dev` and the jar when run from this folder.
DB_PASSWORD=
DISPATCHER_PASSWORD=
COURIER_PASSWORD=
# At least 32 random characters, e.g. from: openssl rand -base64 32
WAYPOINT_SESSION_KEY=

# Only needed outside docker compose
# DB_URL=jdbc:postgresql://localhost:5432/waypoint
# DB_USER=waypoint
